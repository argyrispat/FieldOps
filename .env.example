# =============================================================================
# FieldOps environment template (portfolio / demo)
# Copy to `.env` and adjust. Never commit real secrets or production credentials.
# =============================================================================

# PostgreSQL
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=fieldops_dev_password
POSTGRES_DB=fieldops
POSTGRES_PORT=5432

# Connection string used by the API (Docker Compose service hostname: postgres)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=fieldops;Username=fieldops;Password=fieldops_dev_password

# JWT — generate a long random secret (≥ 32 chars) for any shared/deployed environment
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=FieldOps
Jwt__Audience=FieldOps
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# CORS (comma-separated front-end origins)
Cors__Origins=http://localhost:5173,http://localhost:3000

# File storage (job photo uploads)
FileStorage__RootPath=/app/uploads
FileStorage__MaxBytes=5242880

# ASP.NET
# Use Development for local demo (Swagger, seed data defaults). Use Production only after
# replacing Jwt__Key and reviewing HTTPS / proxy settings.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Optional database bootstrap (defaults to true in Development)
# Database__MigrateOnStartup=true
# Database__SeedDemoData=true

# Frontend (Vite) — API base URL baked in at build time for Docker images
VITE_API_URL=http://localhost:8080/api
